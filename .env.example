# Exemplo de configuração .env para INPROLIB

# Flask
SECRET_KEY=troque_esta_chave
RESET_TOKEN_EXP_SECONDS=600

# Banco de dados
DB_NAME=inprolib_schema
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
# NÃO ALTERE: manter o schema do Postgres como 'public'
DB_SCHEMA=public

# Opcional: usar URL única de conexão (sobrescreve DB_* acima)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inprolib_schema

# SMTP — ajuste conforme seu provedor
# Gmail (STARTTLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=0
SMTP_USER=suporteinprolib@gmail.com
# ATENÇÃO: Gmail exige 2FA e "Senha de app". Crie uma senha de app em
# https://support.google.com/accounts/answer/185833 e use abaixo.
SMTP_PASSWORD=kugxhfundwqavreb
SMTP_FROM=suporteinprolib@gmail.com

# Em provedores com problemas de IPv6 (ex.: Render), force IPv4
SMTP_FORCE_IPV4=0
# Ajuste de timeout para evitar travas (segundos)
SMTP_TIMEOUT=15

# Mostrar código na UI (apenas desenvolvimento)
SHOW_RESET_TOKEN_IN_UI=0

# Alternativa: Outlook/Office365
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USE_SSL=0
# SMTP_USER=seu_email@empresa.com
# SMTP_PASSWORD=sua_senha_ou_token
# SMTP_FROM=seu_email@empresa.com

# API de E-mail (Brevo)
# Para usar a API (recomendado no Render), defina:
# EMAIL_API_PROVIDER=brevo
# BREVO_API_KEY=sua_chave_api_aqui
# BREVO_SENDER_EMAIL=remetente_verificado@seu_dominio.com
# BREVO_SENDER_NAME=INPROLIB

# --- Sincronização de Uploads ---
# Token para proteger as rotas de sincronização:
# - /sync_list_missing (GET)
# - /sync_uploads (POST)
# Se UPLOAD_SYNC_TOKEN não estiver definido, o app tenta usar ADMIN_SETUP_TOKEN.
UPLOAD_SYNC_TOKEN=
# Opcional: token administrativo (fallback)
ADMIN_SETUP_TOKEN=